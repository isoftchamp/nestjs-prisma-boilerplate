{
  "name": "nestjs-prisma-boilerplate",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "license": "isoftchamp",
  "engines": {
    "node": "^24.11.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"(src|test|prisma)/**/*.(js|mjs|cjs|jsx|ts|json|json5|jsonc|yml|yaml|md|markdown|graphql|gql|ng|sql|prisma)\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "dev:worker": "nest start --entryFile worker --watch",
    "debug": "nest start --debug --watch",
    "debug:worker": "nest start --entryFile worker --debug --watch",
    "prod": "node build/web.js",
    "prod:worker": "node build/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "test:e2e:watch": "vitest --config ./vitest.config.e2e.mts",
    "postinstall": "prisma generate",
    "pre-commit": "lint-staged",
    "doppler:dev": "doppler run --config dev -- npm run dev",
    "doppler:dev:worker": "doppler run --config dev -- npm run dev:worker",
    "doppler:test": "doppler run --config test -- npm run test",
    "doppler:test:e2e": "doppler run --config test -- npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@keyv/redis": "^6.1.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/websockets": "^12.0.0",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.2",
    "axios": "^1.13.5",
    "bullmq": "^6.7.8",
    "cache-manager": "^7.2.9",
    "chalk": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "ioredis": "^6.0.0",
    "keyv": "^6.1.0",
    "lodash": "^4.18.1",
    "nest-winston": "^2.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-adapter": "^2.5.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-mongodb": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@rspack/core": "^2.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-checker-rspack-plugin": "^1.8.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6",
    "vite": "^8.0.0",
    "vitest": "^5.1.1",
    "webpack-node-externals": "^3.0.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,json5,jsonc,yml,yaml,md,markdown,graphql,gql,ng,sql,prisma}": [
      "prettier --write"
    ]
  }
}
